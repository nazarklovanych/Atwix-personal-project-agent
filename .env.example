# Slack (see slack-manifest.yml for one-paste app setup)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# LLM provider key (Anthropic or OpenAI; pick what your model needs)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override model from ppa.yml ("provider/id")
# PPA_MODEL=anthropic/claude-sonnet-4-5

# Database passwords — name must match password_env in ppa.yml
MAIN_DB_PASSWORD=change-me
